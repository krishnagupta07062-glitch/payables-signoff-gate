# Each person uses their OWN Crustdata key (own 15k credits and own rate limit)
CRUSTDATA_API_KEY=
# Claude API for the extractor and the baseline guard
ANTHROPIC_API_KEY=
GATE_MODEL=claude-opus-5-5
# RazorpayX test mode (Ayush). PAYMENTS_MODE=mock works with no keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
PAYMENTS_MODE=mock
# Secret used to hash account numbers (any random string, same for the whole team)
ACCOUNT_HASH_KEY=
# MOCK=1 runs everything offline from fixtures
MOCK=0

# Model provider for extraction and the baseline guard: anthropic (default) or gemini (free tier)
GATE_PROVIDER=anthropic
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
